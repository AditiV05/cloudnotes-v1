# Copy to .env and fill in real values:   cp .env.example .env
# .env is git-ignored. NEVER commit real secrets.

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# With Docker the host is the service name: db (source) or db-target (after the LU 2.7 migration)
DATABASE_URL=postgresql://cloudnotes:CHANGE_ME_DB_PASSWORD@db:5432/cloudnotes

# Flask secret key. Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_RANDOM_SECRET

# Where uploaded attachments are stored
UPLOAD_FOLDER=/home/cloudnotes/cloudnotes/uploads

# Only used by `python app.py` (dev). gunicorn binds via the service file.
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# Password for the migration target database (db-target, LU 2.7)
TARGET_DB_PASSWORD=CHANGE_ME_TARGET_DB_PASSWORD
